# Sarvam AI API Subscription Key (Obtain from https://indus.sarvam.ai/key-management)
SARVAM_API_KEY=your_sarvam_api_key_here

# Hotkey to trigger voice wake (default: ctrl+space)
PUSH_TO_WAKE_HOTKEY=ctrl+space

# Default voice settings
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=shubh_enhi_ads
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4

# Maximum audio recording duration in seconds
MAX_RECORD_SECONDS=15
